  "appearance": {
    "focus-border-toggle": true,
    "focus-border-radius": 16,
    "split-border-toggle": false,
    "window-gap-size": 8,
    "window-gap-size-increment": 1,
    "window-gap-hidden-on-single": false,
    "window-maximize-on-single": false,
    "focus-border-hidden-on-single": true,
    "window-margin-top": 0,
    "window-margin-bottom": 8,
    "window-margin-left": 8,
    "window-margin-right": 8,
    "preview-hint-enabled": true,
    "showtab-decoration-enabled": true,
    "tabbed-tab-margin": 4,
    "stacked-tab-bar-height": 32,
    "tab-position": "top",
    "quick-settings-enabled": true,
    "tray-icon-enabled": true
  },
  "workspaces": {
    "workspace-skip-tile": "",
    "monitor-skip-tile": ""
  },
  "development": {
    "log-level": 0,
    "logging-enabled": false
  },
  "other": {
    "resize-amount": 50,
    "launch-app-command": "ghostty"
  }
}