{
  "$schema": "file:///home/farzad/.local/share/gnome-shell/extensions/forge@jmmaranan.com/config/settings.schema.json",
  "version": 1,
  "behavior": {
    "tiling-mode-enabled": true,
    "focus-on-hover-enabled": false,
    "move-pointer-focus-enabled": false,
    "auto-split-enabled": false,
    "stacked-tiling-mode-enabled": false,
    "tabbed-tiling-mode-enabled": true,
    "auto-exit-tabbed": true,
    "auto-reorient-on-close": false,
    "default-window-layout": "tiled",
    "dnd-center-layout": "tabbed",
    "float-always-on-top-enabled": true,
    "auto-unmaximize-for-tiling": true,
    "focus-on-hover-tiling-only": false,
    "disable-edge-tiling": true,
    "new-window-placement": "pointer"
