{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": true,
    "notice": false
  },
  "async": true,
  "streaming": 100,
  "cursor_style": "blinking_bar",
  "transient_prompt": {
    "template": "╰─ {{ .Segments.Executiontime.FormattedMs }}{{ .Segments.Status.Text }}\n╭─ ",
    "foreground": "8"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "template": "╰─ {{ .FormattedMs }}",
          "foreground": "8",
          "options": {
            "always_enabled": true,
            "style": "austin",
            "threshold": 500
          }
        },
        {
          "type": "status",
          "style": "plain",
          "template": "{{ if .Error }} [{{ reason .Code }}] {{ end }}\n",
          "foreground": "8",
          "options": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "╭─ ",
          "foreground": "22"
        },
        {
          "type": "session",
          "style": "plain",
          "template": "{{ if .SSHSession }}{{ index (splitList \".\" .HostName) 0 }} <default>•</> {{ end }}",
          "foreground": "22"
        },
        {
          "type": "path",
          "style": "plain",
          "template": "{{ .Path }} ",
          "foreground": "green",
          "options": {
            "style": "agnoster_full"
          }
        },
        {
          "type": "jujutsu",
          "style": "plain",
          "template": "<default>•</> @ {{.ChangeID}}<d>{{if .Working.Changed}} {{ .Working.String }}{{ end }}{{ if .ClosestBookmarks }} {{ .ClosestBookmarks }}{{ end }}</>",
          "foreground": "blue"
        },
        {
          "type": "git",
          "style": "plain",
          "template": "{{ if not (.Segments.Contains \"Jujutsu\") }}<default>•</> {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ end }}",
          "foreground": "blue",
          "options": {
            "native_status": true,
            "branch_icon": " ",
            "cherry_pick_icon": " ",
            "commit_icon": " ",
            "merge_icon": " ",
            "no_commits_icon": " ",
            "rebase_icon": " ",
            "revert_icon": " ",
            "tag_icon": " "
          }
        },
        {
          "type": "python",
          "style": "plain",
          "template": " <default>•</> {{ if .Venv }} <d>{{ .Venv }}</d> {{ end }}",
          "foreground": "magenta"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "╰─",
          "foreground": "22"
        }
      ],
      "newline": true
    }
  ],
  "final_space": true
}
