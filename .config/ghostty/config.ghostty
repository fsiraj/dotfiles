# Styling - Editor
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
adjust-cell-width = -10%
adjust-cell-height = 10%
cursor-style = bar
cursor-style-blink = true
# custom-shader = cursor-trail.glsl

# Styling - Window
title = "󰊠"
window-theme = ghostty
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true

# Styling - System Specific
gtk-titlebar = false
macos-titlebar-style = hidden

# Colors (auto generated on theme sync)
config-file = ?theme.ghostty
palette-generate = true

# Other
shell-integration-features = sudo,ssh-env,ssh-terminfo
app-notifications = config-reload,no-clipboard-copy
macos-option-as-alt = true

# Keymaps

# Splits (Panes)
keybind = ctrl+shift+minus=new_split:down
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+x=close_surface
keybind = ctrl+shift+equal=equalize_splits

# Tabs
keybind = ctrl+shift+t=new_tab

# Windows
keybind = ctrl+shift+enter=toggle_fullscreen

# Resolves conflicts with other things
keybind = ctrl+enter=unbind
